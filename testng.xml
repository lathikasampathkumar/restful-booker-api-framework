<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Default regression run: everything except tests that fail because of known restful-booker bugs -->
<suite name="Restful Booker API - Regression" parallel="classes" thread-count="3">
  <test name="Regression">
    <groups>
      <run>
        <exclude name="known-defects"/>
      </run>
    </groups>
    <classes>
      <class name="com.lathika.tests.CreateBookingTest"/>
      <class name="com.lathika.tests.GetBookingTest"/>
      <class name="com.lathika.tests.BookingLifecycleTest"/>
      <class name="com.lathika.tests.BookingSchemaTest"/>
      <class name="com.lathika.tests.CreateBookingValidationTest"/>
      <class name="com.lathika.tests.BookingAuthTest"/>
    </classes>
  </test>
</suite>
